# ---------------------------------------------------------------------------
# HomeOS configuration. Copy to .env (scripts/windows/init-env.ps1 does this
# and fills in the secrets for you). Never commit .env.
# ---------------------------------------------------------------------------

# Base domain. Every service gets a subdomain: home., auth., media., vault., ha.
HOMEOS_DOMAIN=home.example.com

# LAN IP of this Windows machine (set a DHCP reservation for it on your router).
HOST_LAN_IP=192.168.1.10

# LAN IP of the Home Assistant OS VM (also reserve this on your router).
HA_LAN_IP=192.168.1.11

TZ=America/Chicago

# Where data lives on the Windows host. Forward slashes work with Docker Desktop.
DATA_DIR=./data
MEDIA_DIR=D:/Media

# --- TLS -------------------------------------------------------------------
# "cloudflare": real Let's Encrypt certs via DNS challenge (recommended; phones
#               and the Bitwarden app trust them with no extra setup).
# "internal":   Caddy's own CA; you must install its root cert on every device.
TLS_MODE=cloudflare
ACME_EMAIL=you@example.com
CLOUDFLARE_API_TOKEN=

# --- Authentik (SSO / permissions) -----------------------------------------
AUTHENTIK_TAG=2025.10
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=

# --- Vaultwarden (password manager) ---------------------------------------
# Admin panel token (https://vault.<domain>/admin). Leave signups off and
# invite family members from the admin panel instead.
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_SIGNUPS_ALLOWED=false

# --- OpenClaw / MobileVault -----------------------------------------------
# Tailscale Serve URL of the OpenClaw Gateway on this PC, printed by
# scripts/windows/setup-openclaw.ps1 (e.g. https://homepc.tail1234.ts.net).
# This is the address you enter in MobileVault. Used for the dashboard link.
OPENCLAW_URL=

# --- Voice (Wyoming) -------------------------------------------------------
# Whisper model: tiny-int8 / base-int8 / small-int8. Bigger = more accurate, slower.
WHISPER_MODEL=base-int8
WHISPER_LANG=en
PIPER_VOICE=en_US-lessac-medium
